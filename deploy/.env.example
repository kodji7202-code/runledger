# Copy this file to deploy/.env and fill it in. Docker Compose reads deploy/.env automatically.
# Team API keys come from `runledger team create` and are never stored here.

# Host name of the server. Its DNS record must point at this machine, and ports 80 and 443
# must be reachable from the internet, or Caddy cannot obtain the HTTPS certificate.
RUNLEDGER_DOMAIN=runledger.example.com

# Public base URL, used in approval links. Use the HTTPS address for RUNLEDGER_DOMAIN,
# with no trailing slash.
RUNLEDGER_PUBLIC_URL=https://runledger.example.com

# Optional: the Compose network's subnet (see docs/self-hosting.md), e.g. 172.20.0.0/16.
RUNLEDGER_TRUSTED_PROXIES=

# Optional: delete runs, their history, approvals and budget alerts older than this many days.
# 35 or more; a smaller value is raised to 35 with a warning. Empty keeps everything.
RUNLEDGER_RETENTION_DAYS=

# Optional: delete audit events older than this many days, on their own schedule.
# Empty keeps them for 365 days while runs are pruned (and for ever when they are not); 0 keeps
# them for ever.
RUNLEDGER_AUDIT_RETENTION_DAYS=
