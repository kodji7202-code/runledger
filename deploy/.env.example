# Copy this file to deploy/.env and fill it in. Docker Compose reads deploy/.env automatically.
# Team API keys come from `runledger team create` (or from billing) and are never stored here.
# With the hosted plan settings below filled in, this file holds secrets: chmod 600 deploy/.env.

# Host name of the server. Its DNS record must point at this machine, and ports 80 and 443
# must be reachable from the internet, or Caddy cannot obtain the HTTPS certificate.
RUNLEDGER_DOMAIN=runledger.example.com

# Public base URL, used in approval links and emails. Use the HTTPS address for RUNLEDGER_DOMAIN,
# with no trailing slash.
RUNLEDGER_PUBLIC_URL=https://runledger.example.com

# Optional: the Compose network's subnet (see docs/self-hosting.md), e.g. 172.20.0.0/16.
RUNLEDGER_TRUSTED_PROXIES=

# Optional: delete runs, approvals and audit events older than this many days (the hosted plan uses 90).
RUNLEDGER_RETENTION_DAYS=

# ---- Hosted plan only (docs/hosted.md). Leave these empty for a normal self-hosted server. ----

# Polar > Settings > Webhooks: the endpoint's secret. Setting it turns billing on.
RUNLEDGER_POLAR_WEBHOOK_SECRET=
# Optional: only these Polar product ids create teams (comma separated).
RUNLEDGER_POLAR_PRODUCT_IDS=
# Polar customer portal, linked from emails and the dashboard, e.g. https://polar.sh/your-org/portal
RUNLEDGER_BILLING_PORTAL_URL=
# Resend API key (sending access only) and a sender on a domain verified in Resend.
RUNLEDGER_RESEND_API_KEY=
RUNLEDGER_MAIL_FROM=RunLedger <team@mail.example.com>
# Where customers reply for help.
RUNLEDGER_SUPPORT_EMAIL=support@example.com
