# Copy this file to deploy/.env and fill it in. Docker Compose reads deploy/.env automatically.
# The file holds no secrets. Team API keys come from `runledger team create` and are never stored here.

# Host name of the server. Its DNS record must point at this machine, and ports 80 and 443
# must be reachable from the internet, or Caddy cannot obtain the HTTPS certificate.
RUNLEDGER_DOMAIN=runledger.example.com

# Public base URL, used in approval links. Use the HTTPS address for RUNLEDGER_DOMAIN,
# with no trailing slash.
RUNLEDGER_PUBLIC_URL=https://runledger.example.com
